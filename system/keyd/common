# 所有键盘共用的键位，由 default.conf 和 razer-huntsman.conf 引用
# 没有 .conf 后缀，keyd 不会把它当成单独的配置加载
# caps lock：短按（200ms 内松开）= esc；按住 = ctrl，但下面列出的键改发 ctrl+alt+super+键，只给 niri 用
# 用 overloadt2 而不是 overload：按住后犹豫一下再松开不会误发 esc；按住期间按了别的键立刻当作按住，快速连按也不会漏

[main]
capslock = overloadt2(wm, esc, 200)

# 按住 caps 时默认就是 ctrl（Caps+C / Caps+R / Caps+W 等照常）
# 下面的键例外：改发 ctrl+alt+super+键，没有应用会用到这个组合；KDE 下它们什么都不做
# 同时按住 shift 会原样带上，所以 Caps+Shift+键 也能单独绑定（见 system/niri/local.kdl）
[wm:C]
h = C-A-M-h
j = C-A-M-j
k = C-A-M-k
l = C-A-M-l
left = C-A-M-left
down = C-A-M-down
up = C-A-M-up
right = C-A-M-right
1 = C-A-M-1
2 = C-A-M-2
3 = C-A-M-3
4 = C-A-M-4
5 = C-A-M-5
6 = C-A-M-6
7 = C-A-M-7
8 = C-A-M-8
9 = C-A-M-9
u = C-A-M-u
i = C-A-M-i
o = C-A-M-o
tab = C-A-M-tab
