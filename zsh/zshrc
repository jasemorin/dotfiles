# zsh 配置（macOS）。部署：install.sh 会把 ~/.zshrc 链接到这里
# 和 Linux 上 system/bash/tools.sh + inputrc 的习惯保持一致。
# 密钥、只属于这台机器的东西放 ~/.zshrc.local（不进仓库），文件末尾会自动加载。

# ── Homebrew 补全路径（要在 compinit 之前）──────────────────────────────
if command -v brew >/dev/null; then
  fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi

# ── 历史：存更多、去重、多个终端实时共享 ─────────────────────────────────
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=100000
setopt share_history          # 每条命令执行完就写盘，其他终端也能翻到
setopt extended_history       # 记录时间
setopt hist_ignore_all_dups   # 重复命令只留最新一条
setopt hist_ignore_space      # 空格开头的命令不进历史（输密钥时有用）
setopt hist_reduce_blanks

# ── 目录与通配 ──────────────────────────────────────────────────────────
setopt auto_cd                # 输目录名直接 cd
setopt auto_pushd pushd_ignore_dups
setopt extended_glob          # ** 递归匹配等
setopt interactive_comments

# ── Tab 补全：不分大小写、- 和 _ 视为相同、方向键选择 ────────────────────
autoload -Uz compinit && compinit -C
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' special-dirs true
setopt auto_list list_types

# ── ↑/↓：按已输入的开头搜历史（输 git 再按 ↑，只翻 git 开头的）────────
bindkey -e                    # emacs 风格行编辑（Ctrl-A/E/W 等）；要在下面的绑定之前
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# ── 编辑器 ──────────────────────────────────────────────────────────────
export EDITOR=nvim VISUAL=nvim
alias vim=nvim v=nvim

# ── eza：带图标、目录在前；ll 详细（含 git 状态）、la 含隐藏、lt 树状 ──
if command -v eza >/dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
  alias ll='ls -l --git --time-style=relative'
  alias la='ll -a'
  alias lt='ls --tree --level=2'
fi

# ── bat：cat 带高亮；man 也用 bat 着色 ──────────────────────────────────
if command -v bat >/dev/null; then
  alias cat='bat -pp'
  export BAT_THEME=gruvbox-dark
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
  export MANROFFOPT='-c'
fi

# ── fzf：Ctrl-R 模糊搜历史、Ctrl-T 找文件、Alt-C 模糊 cd ─────────────────
if command -v fzf >/dev/null; then
  # Gruvbox Dark 配色（bg 留空，跟随终端背景/透明度）
  export FZF_DEFAULT_OPTS='--height 40% --layout reverse --border
    --color=fg:#ebdbb2,hl:#fabd2f,fg+:#ebdbb2,bg+:#3c3836,hl+:#fabd2f
    --color=info:#83a598,prompt:#b8bb26,pointer:#fb4934,marker:#8ec07c,spinner:#d3869b,header:#928374,border:#665c54'
  if command -v rg >/dev/null; then
    export FZF_DEFAULT_COMMAND="rg --files --hidden --glob '!.git'"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi
  command -v bat >/dev/null && export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {}'"
  command -v eza >/dev/null && export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"
  source <(fzf --zsh)
fi

# ── zoxide：z 名字 跳到常去的目录，zi 交互选择 ─────────────────────────
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ── 语言环境 ────────────────────────────────────────────────────────────
# pyenv（装了才启用）
command -v pyenv >/dev/null && eval "$(pyenv init - zsh)"
# libpq（psql 等，Homebrew 不会自动加进 PATH）
[[ -d /opt/homebrew/opt/libpq/bin ]] && path=(/opt/homebrew/opt/libpq/bin $path)
# SDKMAN（Java；官方要求放在靠后的位置）
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# ── 本机专属 / 密钥（不进仓库）─────────────────────────────────────────
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# ── 插件：自动建议（灰字，→ 接受）和语法高亮（必须最后加载）────────────
if command -v brew >/dev/null; then
  _bp="$(brew --prefix)/share"
  [[ -f $_bp/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && source $_bp/zsh-autosuggestions/zsh-autosuggestions.zsh
  [[ -f $_bp/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && source $_bp/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  unset _bp
fi

# ── starship 提示符（放最后）───────────────────────────────────────────
export STARSHIP_CONFIG=~/.config/starship/starship.toml
command -v starship >/dev/null && eval "$(starship init zsh)"
