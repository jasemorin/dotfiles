// ──────────────────────────────────────────────
//  niri 配置（Asahi / MacBook Pro 13" M2）
//  键位约定（详见 README）：
//    caps 按住 + 窗口键 = 窗口管理（keyd 发出 ctrl+alt+super+键，见 system/keyd）
//    cmd(super)        = macOS 式系统命令：cmd+space / cmd+q / cmd+shift+3/4/5
//    alt               = 不占用，留给终端和应用
//  改完先跑 `niri validate`；保存后 niri 会自动重载
// ──────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"
            // caps lock 键由 keyd 处理，这里不要再加 caps: 选项
            // 大小写锁定改为同时按左右 shift（再按一次关闭）
            options "shift:both_capslock"
        }
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        dwt
        natural-scroll
        // 两指点按 = 右键，与 macOS 一致
        click-method "clickfinger"
        scroll-factor 0.6
    }

    // Mod 只用于鼠标（按住 cmd 拖动窗口）和 cmd 系列键位；窗口键走 caps 层
    // 嵌套运行时（在 GNOME 里开 niri 窗口测试）用 alt
    mod-key "Super"
    mod-key-nested "Alt"

    workspace-auto-back-and-forth

    // 鼠标悬停即聚焦；max-scroll-amount="0%"：只聚焦完全在屏幕内的窗口，
    // 鼠标扫过屏幕边缘露出一截的窗口时不会把整个视图滚过去
    focus-follows-mouse max-scroll-amount="0%"
}

// GNOME 在这块屏上默认 166%，等效 macOS 的「看起来像 1536x960」
output "eDP-1" {
    scale 1.666667
}

layout {
    gaps 10
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // Catppuccin Mocha，与 kitty 主题一致
    focus-ring {
        width 2
        active-color "#b4befe"
        inactive-color "#6c7086"
    }

    border {
        off
    }

    shadow {
        on
    }
}

// 模糊强度主要看 passes × offset；默认 3 / 3.0 在花哨壁纸上不够明显
// 觉得卡就把 passes 调回 3
blur {
    passes 4
    offset 6.0
    noise 0.02
    saturation 1.5
}

prefer-no-csd

// 临时用自己编译的 xwayland-satellite 0.8.3（~/.local/src，cargo build --release）：
// Fedora 的 0.8.2 有回归，Steam 等 X11 应用的下拉菜单一打开就消失。Fedora 更新到 0.8.3 后删掉这段
xwayland-satellite {
    path "~/.local/bin/xwayland-satellite"
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    hide-when-typing
}

environment {
    // Electron 应用（VS Code、Discord 等）走原生 Wayland
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // 输入法 fcitx5：Wayland 原生应用（GTK、kitty、Firefox）走 text-input 协议，不设 GTK_IM_MODULE；
    // Qt 先试 Wayland 再退回 fcitx 模块；X11 应用（xwayland-satellite）用 XMODIFIERS
    QT_IM_MODULES "wayland;fcitx"
    XMODIFIERS "@im=fcitx"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── 开机启动 ──────────────────────────────────
// 顶栏：Quickshell（config/quickshell，胶囊各自模糊）；没装时退回 waybar
spawn-sh-at-startup "command -v qs >/dev/null && exec qs || exec waybar"
// 通知：Quickshell 自己当通知服务（config/quickshell/Notifs.qml）；没装 quickshell 时退回 swaync
spawn-sh-at-startup "command -v qs >/dev/null || exec swaync"
// 壁纸：~/Pictures/wallpaper/uluru1.JPEG；没有的话用纯色
spawn-sh-at-startup "if [ -f ~/Pictures/wallpaper/uluru1.JPEG ]; then exec swaybg -m fill -i ~/Pictures/wallpaper/uluru1.JPEG; else exec swaybg -c '#1e1e2e'; fi"
// 5 分钟锁屏，再过 30 秒关屏，合盖前锁屏
spawn-sh-at-startup "swayidle -w timeout 300 'swaylock -f' timeout 330 'niri msg action power-off-monitors' before-sleep 'swaylock -f'"
// 密码弹窗（polkit 认证代理）：没有它，需要管理员权限的图形操作会静默失败
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
// 剪贴板历史：记录每次复制（文本和图片），cmd+shift+v 打开
spawn-sh-at-startup "wl-paste --watch cliphist store"
// 中文输入法（小鹤双拼，Alt+Space 切换，配置在 config/fcitx5）；--replace 防止和系统自启动的重复
spawn-at-startup "fcitx5" "-d" "--replace"

// ── 窗口规则 ──────────────────────────────────
// 所有窗口圆角；blur 需要正确的几何裁剪
// open-maximized-to-edges false：Firefox 等请求最大化时只占满列（保留间隙和圆角），不贴边变方角
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    open-maximized-to-edges false
}

// kitty 背景模糊（linux.conf 里 background_opacity 0.80）
// draw-border-with-background false：否则聚焦时 focus ring 会画成实心底色透出来，看着像不透明
window-rule {
    match app-id="^kitty$"
    draw-border-with-background false
    background-effect {
        blur true
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id=r#"^org\.gnome\.(Calculator|Settings)$"#
    match app-id="^pavucontrol$"
    open-floating true
}

// 启动器模糊；圆角要和 fuzzel.ini 的 radius 一致，否则模糊层是方角
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 12
    background-effect {
        blur true
    }
}

// Quickshell 的音量/亮度提示、快捷设置面板、通知弹窗和通知中心盖在窗口上：模糊背后的窗口，而不是默认的 xray（只透出壁纸）
// 模糊区域由 quickshell 自己通过 ext-background-effect 申请，这里只改 xray
layer-rule {
    match namespace="^quickshell-(osd|quicksettings|notifications|notificationcenter)$"
    background-effect {
        xray false
    }
}

// waybar（备用顶栏）不开模糊：niri 会模糊整个图层矩形，胶囊之间会出现一条磨砂横带；
// Quickshell 顶栏自己通过 ext-background-effect 申请只模糊胶囊，不需要规则

// kitty 下拉终端（caps+shift+enter）模糊；namespace 来自 quick-access-terminal 的 app_id 默认值
layer-rule {
    match namespace="^kitty-quick-access$"
    background-effect {
        blur true
    }
}

// ── 键位 ──────────────────────────────────────
// Ctrl+Alt+Super+键 = caps 按住 + 键（由 keyd 发出，见 system/keyd/default.conf）
// 只有 keyd 里列出的键能用；要加新键，两边都要改
binds {
    // caps+shift+/ 显示全部快捷键
    Ctrl+Alt+Super+Shift+Slash { show-hotkey-overlay; }

    // 焦点：caps+hjkl；加 shift 移动窗口
    Ctrl+Alt+Super+H { focus-column-left; }
    Ctrl+Alt+Super+J { focus-window-or-workspace-down; }
    Ctrl+Alt+Super+K { focus-window-or-workspace-up; }
    Ctrl+Alt+Super+L { focus-column-right; }
    Ctrl+Alt+Super+Shift+H { move-column-left; }
    Ctrl+Alt+Super+Shift+J { move-window-down-or-to-workspace-down; }
    Ctrl+Alt+Super+Shift+K { move-window-up-or-to-workspace-up; }
    Ctrl+Alt+Super+Shift+L { move-column-right; }

    // 工作区：caps+数字；加 shift 把窗口送过去
    // 再按一次当前工作区的数字 = 回到上一个（workspace-auto-back-and-forth）
    Ctrl+Alt+Super+1 { focus-workspace 1; }
    Ctrl+Alt+Super+2 { focus-workspace 2; }
    Ctrl+Alt+Super+3 { focus-workspace 3; }
    Ctrl+Alt+Super+4 { focus-workspace 4; }
    Ctrl+Alt+Super+5 { focus-workspace 5; }
    Ctrl+Alt+Super+6 { focus-workspace 6; }
    Ctrl+Alt+Super+7 { focus-workspace 7; }
    Ctrl+Alt+Super+8 { focus-workspace 8; }
    Ctrl+Alt+Super+9 { focus-workspace 9; }
    Ctrl+Alt+Super+Shift+1 { move-column-to-workspace 1; }
    Ctrl+Alt+Super+Shift+2 { move-column-to-workspace 2; }
    Ctrl+Alt+Super+Shift+3 { move-column-to-workspace 3; }
    Ctrl+Alt+Super+Shift+4 { move-column-to-workspace 4; }
    Ctrl+Alt+Super+Shift+5 { move-column-to-workspace 5; }
    Ctrl+Alt+Super+Shift+6 { move-column-to-workspace 6; }
    Ctrl+Alt+Super+Shift+7 { move-column-to-workspace 7; }
    Ctrl+Alt+Super+Shift+8 { move-column-to-workspace 8; }
    Ctrl+Alt+Super+Shift+9 { move-column-to-workspace 9; }

    // 大小：caps+, / caps+. 调列宽；加 shift 调高度
    Ctrl+Alt+Super+Comma       { set-column-width "-10%"; }
    Ctrl+Alt+Super+Period      { set-column-width "+10%"; }
    Ctrl+Alt+Super+Shift+Comma  { set-window-height "-10%"; }
    Ctrl+Alt+Super+Shift+Period { set-window-height "+10%"; }
    // caps+' 轮换列宽预设（⅓ ½ ⅔ 全宽）；加 shift 在浮动/平铺窗口间切焦点
    Ctrl+Alt+Super+Apostrophe       { switch-preset-column-width; }
    Ctrl+Alt+Super+Shift+Apostrophe { switch-focus-between-floating-and-tiling; }
    // caps+m 最大化列；加 shift 全屏
    Ctrl+Alt+Super+M       { maximize-column; }
    Ctrl+Alt+Super+Shift+M { fullscreen-window; }

    // 布局：caps+[ ] 把窗口并入/拆出相邻列；caps+; 同列窗口叠成标签；加 shift 切浮动
    Ctrl+Alt+Super+BracketLeft  { consume-or-expel-window-left; }
    Ctrl+Alt+Super+BracketRight { consume-or-expel-window-right; }
    Ctrl+Alt+Super+Semicolon       { toggle-column-tabbed-display; }
    Ctrl+Alt+Super+Shift+Semicolon { toggle-window-floating; }

    // caps+` 概览（类似 Mission Control）
    Ctrl+Alt+Super+Grave repeat=false { toggle-overview; }

    // caps+enter 新开 kitty；加 shift 下拉终端
    Ctrl+Alt+Super+Return       hotkey-overlay-title="打开 kitty" { spawn "kitty"; }
    Ctrl+Alt+Super+Shift+Return hotkey-overlay-title="下拉终端" { spawn "kitten" "quick-access-terminal"; }

    // 逃生口：应用抢占快捷键时 caps+esc 恢复
    Ctrl+Alt+Super+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // caps+shift+esc：重启进 macOS（只这一次，会弹密码框确认）
    Ctrl+Alt+Super+Shift+Escape hotkey-overlay-title="重启进 macOS" { spawn "~/.local/bin/reboot-macos"; }

    // ── cmd：macOS 习惯 ──
    Super+Space  hotkey-overlay-title="启动器 (Spotlight)" { spawn "fuzzel"; }
    Super+Q      repeat=false { close-window; }
    Super+Ctrl+Q hotkey-overlay-title="锁屏" { spawn "swaylock" "-f"; }
    // 剪贴板历史：选中后用 cmd+v / caps+v 粘贴
    Super+Shift+V hotkey-overlay-title="剪贴板历史" { spawn-sh "cliphist list | fuzzel --dmenu --prompt '剪贴板 ' | cliphist decode | wl-copy"; }

    // 截图：cmd+shift+3 全屏 / 4 选区 / 5 窗口
    Super+Shift+3 { screenshot-screen; }
    Super+Shift+4 { screenshot; }
    Super+Shift+5 { screenshot-window; }

    // cmd+滚轮 切工作区 / 左右切列
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // 媒体键（Touch Bar 由 tiny-dfr 发出这些键）
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
    // 键盘背光：Touch Bar 媒体层（按住 fn）第 5、6 个键
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--device=kbd_backlight" "set" "+10%"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--device=kbd_backlight" "set" "10%-"; }

    Ctrl+Alt+Delete { quit; }
}
